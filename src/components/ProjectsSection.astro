---
import type { Project } from '~/types'
import IconChevronsRight from '~/icons/chevrons-right.svg'
import IconGithub from '~/icons/github.svg'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5">
  {
    projects.map((project) => (
      <li class="bg-foreground/5 rounded-xl px-4 py-3.5 flex flex-col">
        <div class="flex items-center justify-between gap-2">
          <span class="text-lg font-semibold text-heading1">{project.name}</span>
          <span class="shrink-0 rounded-full bg-foreground/7 text-foreground/90 px-2 py-1 text-xs font-semibold">
            {project.language}
          </span>
        </div>
        <p class="mt-2.5 mb-4 text-sm/6 text-foreground/90 grow">{project.description}</p>
        <div class="flex items-center gap-3">
          <a
            class="button !py-1 !px-2.5 text-sm items-center"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Docs
            <IconChevronsRight class="size-4 ml-1" />
          </a>
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            <span class="sr-only">{project.name} on GitHub</span>
            <IconGithub class="size-5" />
          </a>
        </div>
      </li>
    ))
  }
</ul>
